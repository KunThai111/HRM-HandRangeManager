# Copy to .env and fill in real values. NEVER commit .env.

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Where Google should redirect back. MUST match the entry in Google Console.
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# A long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Where the frontend lives. After login the server redirects here.
FRONTEND_ORIGIN=http://localhost:5173

# Server port
PORT=3001

# Where SQLite file lives (relative to server/ cwd)
DB_PATH=./data/hrm.db
