{
  "name": "nlh-range",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:debug": "cross-env VITE_DEBUG_NO_AUTH=1 vite",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "concurrently -k -n web,api -c blue,magenta \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc --noEmit && cross-env VITE_DEPLOY_TARGET=server vite build && rimraf server/public && copyfiles -u 1 \"dist/**/*\" server/public",
    "start:server": "npm --prefix server run start:prod",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm --prefix server run typecheck",
    "install:all": "npm install && npm --prefix server install"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
